# --- Development notes and AI assistant files (never part of the repo) ---
.dev/
CLAUDE*.md
.claude/

# --- Rust build (src/rust) ---
src/rust/target/
src/rust/vendor/
# CARGO_HOME used during the package build.
src/.cargo/

# --- Compiled objects from R CMD INSTALL ---
src/*.o
src/*.so
src/*.dll

# --- Generated by ./configure from src/Makevars*.in (removed by ./cleanup) ---
src/Makevars
src/Makevars.win

# --- pkgdown site (built and deployed to gh-pages by CI) ---
docs/

# --- R and RStudio session files ---
.Rproj.user/
.Rhistory

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
# Resource forks and metadata files on non-HFS volumes
._*
# Volume-level files
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
